{
  "manifest_version": 3,
  "name": "Reels Blocker for Facebook",
  "version": "1.3.0",
  "description": "Hide Facebook feed videos and images, and block YouTube Shorts. Regular YouTube videos keep working.",
  "permissions": [
    "storage"
  ],
  "action": {
    "default_title": "Reels and Shorts blocking settings",
    "default_popup": "popup.html"
  },
  "content_scripts": [
    {
      "matches": [
        "https://*.facebook.com/*",
        "https://facebook.com/*"
      ],
      "js": [
        "content.js"
      ],
      "css": [
        "content.css"
      ],
      "run_at": "document_start"
    },
    {
      "matches": [
        "https://*.youtube.com/*",
        "https://youtube.com/*"
      ],
      "js": [
        "youtube.js"
      ],
      "css": [
        "content.css"
      ],
      "run_at": "document_start"
    }
  ],
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "128": "icons/icon-128.png",
    "256": "icons/icon-256.png",
    "512": "icons/icon-512.png"
  }
}
