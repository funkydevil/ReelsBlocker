{
  "manifest_version": 3,
  "name": "__MSG_appName__",
  "version": "1.4.0",
  "description": "__MSG_appDescription__",
  "permissions": [
    "storage",
    "nativeMessaging"
  ],
  "action": {
    "default_title": "__MSG_toolbarTitle__",
    "default_popup": "popup.html"
  },
  "content_scripts": [
    {
      "matches": [
        "https://*.facebook.com/*",
        "https://facebook.com/*"
      ],
      "js": [
        "i18n.js",
        "content.js"
      ],
      "css": [
        "content.css"
      ],
      "run_at": "document_start"
    },
    {
      "matches": [
        "https://*.youtube.com/*",
        "https://youtube.com/*"
      ],
      "js": [
        "i18n.js",
        "youtube.js"
      ],
      "css": [
        "content.css"
      ],
      "run_at": "document_start"
    }
  ],
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "128": "icons/icon-128.png",
    "256": "icons/icon-256.png",
    "512": "icons/icon-512.png"
  },
  "default_locale": "en"
}
